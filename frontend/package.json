{
  "name": "veadk-a2ui-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VeADK A2UI web UI — renders agent-driven UI over the ADK API server.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
