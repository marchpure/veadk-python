{
  "$defs": {
    "CapabilityReason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CapabilityReason",
      "type": "object"
    },
    "ConnectionViewModel": {
      "additionalProperties": false,
      "description": "The only connection representation safe to expose to browser clients.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "workspaceId": {
          "title": "Workspaceid",
          "type": "string"
        },
        "connectorKey": {
          "title": "Connectorkey",
          "type": "string"
        },
        "displayName": {
          "title": "Displayname",
          "type": "string"
        },
        "scope": {
          "enum": [
            "personal",
            "team"
          ],
          "title": "Scope",
          "type": "string"
        },
        "ownerId": {
          "title": "Ownerid",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "config_required",
            "credential_blocked",
            "unsupported",
            "revoked"
          ],
          "title": "Status",
          "type": "string"
        },
        "syncMode": {
          "enum": [
            "full",
            "incremental",
            "realtime",
            "local"
          ],
          "title": "Syncmode",
          "type": "string"
        },
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "updatedAt": {
          "title": "Updatedat",
          "type": "string"
        },
        "lastSuccessAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastsuccessat"
        },
        "lastError": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "discoveredResources": {
          "items": {
            "$ref": "#/$defs/DiscoveredResource"
          },
          "title": "Discoveredresources",
          "type": "array"
        },
        "goldenRevisionIds": {
          "items": {
            "type": "string"
          },
          "title": "Goldenrevisionids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "connectorKey",
        "displayName",
        "scope",
        "ownerId",
        "status",
        "syncMode",
        "createdAt",
        "updatedAt"
      ],
      "title": "ConnectionViewModel",
      "type": "object"
    },
    "DiscoveredField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "dataType": {
          "title": "Datatype",
          "type": "string"
        },
        "nullable": {
          "default": true,
          "title": "Nullable",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "dataType"
      ],
      "title": "DiscoveredField",
      "type": "object"
    },
    "DiscoveredResource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "resourceType": {
          "enum": [
            "file",
            "table",
            "document",
            "operation",
            "tool"
          ],
          "title": "Resourcetype",
          "type": "string"
        },
        "schemaName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schemaname"
        },
        "rowCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rowcount"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/DiscoveredField"
          },
          "title": "Fields",
          "type": "array"
        },
        "inputSchema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputschema"
        },
        "outputSchema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputschema"
        },
        "permission": {
          "default": "read",
          "enum": [
            "read",
            "denied"
          ],
          "title": "Permission",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "resourceType"
      ],
      "title": "DiscoveredResource",
      "type": "object"
    },
    "ResourceSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "displayName": {
          "title": "Displayname",
          "type": "string"
        },
        "resourceKind": {
          "default": "skill_draft",
          "enum": [
            "skill_draft",
            "golden_asset",
            "published_skill"
          ],
          "title": "Resourcekind",
          "type": "string"
        },
        "subtype": {
          "default": "skill",
          "enum": [
            "skill",
            "dataset",
            "knowledge",
            "dashboard",
            "semantic",
            "sop",
            "graph_ontology",
            "monitoring"
          ],
          "title": "Subtype",
          "type": "string"
        },
        "space": {
          "enum": [
            "personal",
            "team"
          ],
          "title": "Space",
          "type": "string"
        },
        "lifecycle": {
          "default": "draft",
          "enum": [
            "draft",
            "ready"
          ],
          "title": "Lifecycle",
          "type": "string"
        },
        "version": {
          "default": "DRAFT",
          "title": "Version",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "permission": {
          "default": true,
          "title": "Permission",
          "type": "boolean"
        },
        "assetId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assetid"
        },
        "goldenRevisionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goldenrevisionid"
        },
        "traceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceid"
        },
        "viewRevisionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viewrevisionid"
        },
        "readModel": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Readmodel"
        },
        "skillViewRevision": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skillviewrevision"
        }
      },
      "required": [
        "id",
        "displayName",
        "space"
      ],
      "title": "ResourceSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceSummary"
      },
      "title": "Resources",
      "type": "array"
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/ConnectionViewModel"
      },
      "title": "Connections",
      "type": "array"
    },
    "publications": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Publications",
      "type": "array"
    },
    "routes": {
      "items": {
        "type": "string"
      },
      "title": "Routes",
      "type": "array"
    },
    "workspaceData": {
      "additionalProperties": true,
      "title": "Workspacedata",
      "type": "object"
    },
    "actionLoop": {
      "additionalProperties": {
        "items": {},
        "type": "array"
      },
      "title": "Actionloop",
      "type": "object"
    },
    "access": {
      "additionalProperties": true,
      "title": "Access",
      "type": "object"
    },
    "serverTime": {
      "title": "Servertime",
      "type": "string"
    }
  },
  "required": [
    "resources",
    "connections",
    "publications",
    "routes",
    "workspaceData",
    "actionLoop",
    "access",
    "serverTime"
  ],
  "title": "BootstrapResponse",
  "type": "object"
}
