{
  "$defs": {
    "ResourceSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "displayName": {
          "title": "Displayname",
          "type": "string"
        },
        "resourceKind": {
          "default": "skill_draft",
          "enum": [
            "skill_draft",
            "golden_asset"
          ],
          "title": "Resourcekind",
          "type": "string"
        },
        "subtype": {
          "default": "skill",
          "enum": [
            "skill",
            "dataset",
            "knowledge"
          ],
          "title": "Subtype",
          "type": "string"
        },
        "space": {
          "enum": [
            "personal",
            "team"
          ],
          "title": "Space",
          "type": "string"
        },
        "lifecycle": {
          "default": "draft",
          "enum": [
            "draft",
            "ready"
          ],
          "title": "Lifecycle",
          "type": "string"
        },
        "version": {
          "default": "DRAFT",
          "title": "Version",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "permission": {
          "default": true,
          "title": "Permission",
          "type": "boolean"
        },
        "assetId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assetid"
        },
        "goldenRevisionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goldenrevisionid"
        },
        "traceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceid"
        }
      },
      "required": [
        "id",
        "displayName",
        "space"
      ],
      "title": "ResourceSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceSummary"
      },
      "title": "Resources",
      "type": "array"
    },
    "connections": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Connections",
      "type": "array"
    },
    "publications": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Publications",
      "type": "array"
    },
    "routes": {
      "items": {
        "type": "string"
      },
      "title": "Routes",
      "type": "array"
    },
    "workspaceData": {
      "additionalProperties": true,
      "title": "Workspacedata",
      "type": "object"
    },
    "actionLoop": {
      "additionalProperties": {
        "items": {},
        "type": "array"
      },
      "title": "Actionloop",
      "type": "object"
    },
    "access": {
      "additionalProperties": true,
      "title": "Access",
      "type": "object"
    },
    "serverTime": {
      "title": "Servertime",
      "type": "string"
    }
  },
  "required": [
    "resources",
    "connections",
    "publications",
    "routes",
    "workspaceData",
    "actionLoop",
    "access",
    "serverTime"
  ],
  "title": "BootstrapResponse",
  "type": "object"
}
