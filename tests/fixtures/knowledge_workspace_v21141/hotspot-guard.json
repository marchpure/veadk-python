{
  "schema_version": "knowledge-workspace.hotspot-guard.v1",
  "baseline_commit": "3dbee406d2be8eea5efe1b7fe18199a193f8f25e",
  "single_frozen_production_copy": true,
  "forbidden_artifacts": ["*.tar.gz", "compiled bundle", "*.ipynb", "screenshots", "*.db", "*.log", "*.pid"],
  "forbidden_production_dependencies": ["fixture", "localStorage persistence", "mock Provider", "static success", "fake SSE"],
  "shared_hotspots": [
    "frontend/src/App.tsx",
    "frontend/server/knowledge_assets/service.py",
    "frontend/server/knowledge_assets/repository.py",
    "frontend/server/knowledge_assets/routes.py"
  ],
  "rules": {
    "shared_hotspot_behavior_loc_growth": 0,
    "new_first_party_production_gross_loc_max": 20000,
    "new_first_party_production_net_loc_max": 10000,
    "new_source_review_bytes": 256000,
    "new_file_advisory_loc": 400,
    "new_file_mandatory_split_review_loc": 800,
    "app_tsx_role": "composition only",
    "service_py_role": "compatibility/composition only",
    "repository_py_role": "persistence only",
    "routes_py_role": "protocol mapping only"
  }
}
