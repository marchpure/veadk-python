    "refresh": "POST /golden-assets/{assetId}/refresh and POST /refresh-runs/{runId}/retry",
    "cancel": "POST /golden-assets/{assetId}/refresh-cancel",
    "revoke": "DELETE /source-connections/{connectionId} {reason}",
    "webhook": "mount create_webhook_ingress(application), preserving raw body and signature/delivery/timestamp/trace headers",
    "context": "submit only {kind, objectId, revision, providerRevision}; derive caller server-side and resolve with golden_resource_binding/golden_asset_content",
