# 复制为 .env 并填入真实值（或改用 config.yaml）。
# 标记 [必填] 的变量缺失时 Agent 无法启动。

# 模型名称
MODEL_AGENT_NAME=doubao-seed-1-6-250615
MODEL_AGENT_PROVIDER=openai
MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3/
# [必填] Byaan Data Studio base URL
DATASTUDIO_BASE_URL=https://byaan.example
# [必填] Byaan Data Studio REST API Key
BYAAN_MCP_API_KEY=replace-with-your-byaan-api-key
